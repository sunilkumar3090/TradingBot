# ============================================================
# .env.example — Copy to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Zerodha Kite Connect (required) ──────────────────────────
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── PostgreSQL (required) ──────────────────────────────────
DATABASE_URL=postgresql://trading_user:strong_password@localhost:5432/trading_db

# ── Redis (required) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Telegram notifications (optional) ─────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── LLM Provider ────────────────────────────────────────────
# Options: deepseek (recommended) | openai | ollama
LLM_PROVIDER=deepseek

# ── DeepSeek (recommended — cheap + powerful) ───────────────
# Get free API key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# Use deepseek-reasoner for complex analysis (DeepSeek-R1)
# DEEPSEEK_MODEL=deepseek-reasoner

# ── OpenAI (alternative) ──────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local, free, offline) ────────────────────────
# Install: https://ollama.com then run: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Risk parameters (optional — defaults shown) ───────────
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_DRAWDOWN_PCT=3.0

# ── Environment ───────────────────────────────────────────
ENVIRONMENT=development
